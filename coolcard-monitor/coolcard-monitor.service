[Unit]
Description=Coolcard Magic Product Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOURUSER
WorkingDirectory=YOURPATH
EnvironmentFile=YOURPATH/.env
ExecStart=YOURPATH/venv/bin/python3 YOURPATH/monitor.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
